# Copy this file to .env and fill in values as needed.
# No environment variables are required - defaults work out of the box.

# Optional: override where the shared JSON data store lives.
# Defaults to .data/data.json in the project root.
# DATA_FILE_PATH=./.data/data.json
#
# Deployment note: whatever directory holds this file (and its parent, so
# the file can be auto-created on first run) must be writable by the
# process running the server, and must persist across deploys/restarts -
# this is the only place application data (products, orders) lives. In a
# containerized deployment, mount it as a persistent volume.
